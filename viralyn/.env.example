# PostgreSQL connection string
DATABASE_URL=postgres://viralyn:viralyn@localhost:5432/viralyn
# Claude API key. Without it, AI features show as "Unavailable" (never faked).
ANTHROPIC_API_KEY=
# Optional model override
VIRALYN_MODEL=claude-opus-5-5
# 32-byte hex key for encrypting OAuth tokens at rest: `openssl rand -hex 32`
ENCRYPTION_KEY=
# Public URL of the app (OAuth redirect + worker target)
APP_URL=http://localhost:3000
# LinkedIn developer app (products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn")
# Redirect URL to register: $APP_URL/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Shared secret for the scheduler endpoint; run `npm run worker` alongside the app
CRON_SECRET=
