# PostgreSQL connection string
DATABASE_URL=postgres://viralyn:viralyn@localhost:5432/viralyn
# AI provider: "nvidia" (default) or "anthropic". Without the matching key, AI features show as "Unavailable" (never faked).
AI_PROVIDER=nvidia
# NVIDIA (build.nvidia.com → API Keys). Optional model override; must support tool calling.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Claude (console.anthropic.com), used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VIRALYN_MODEL=claude-opus-5-5
# Optional: USD per million tokens for cost logging (defaults: NVIDIA 0, Claude 4/20)
AI_PRICE_INPUT=
AI_PRICE_OUTPUT=
# 32-byte hex key for encrypting OAuth tokens at rest: `openssl rand -hex 32`
ENCRYPTION_KEY=
# Public URL of the app (OAuth redirect + worker target)
APP_URL=http://localhost:3000
# LinkedIn developer app (products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn")
# Redirect URL to register: $APP_URL/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Shared secret for the scheduler endpoint; run `npm run worker` alongside the app
CRON_SECRET=
